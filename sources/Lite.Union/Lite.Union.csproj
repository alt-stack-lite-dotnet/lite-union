<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <AssemblyName>Lite.Union</AssemblyName>
    <RootNamespace>Lite.Union</RootNamespace>

    <PackageId>Lite.Union</PackageId>
    <Description>Discriminated unions for C# as a source generator: values overlap with values and references with references, so a union is small and does not box. Named cases, Match/Switch, equality, and C# 15 union integration on .NET 11.</Description>
    <PackageTags>union;discriminated-union;sum-type;one-of;source-generator;roslyn;no-boxing;zero-alloc;lite</PackageTags>

    <!-- Source generator packaging: the DLL goes to analyzers/, there is nothing to reference at runtime. -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- The properties file goes to build/ (direct references) and buildTransitive/ (through other packages). -->
  <ItemGroup>
    <None Include="build\Lite.Union.props" Pack="true" PackagePath="build;buildTransitive" Visible="false" />
  </ItemGroup>

  <!-- Pack the generator into the analyzers folder. -->
  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
