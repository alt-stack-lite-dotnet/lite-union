<Project Sdk="Microsoft.NET.Sdk">
  <!-- Strict comparison: out-of-process BenchmarkDotNet on .NET 10. See BENCHMARKS.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);SU0007;CS8618;CS0649;CS0169;CS1591;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="OneOf" Version="3.0.271" />
    <PackageReference Include="Dunet" Version="1.16.2" />
    <PackageReference Include="N.SourceGenerators.UnionTypes" Version="0.28.2" />
    <PackageReference Include="dotVariant" Version="0.5.3" />
    <PackageReference Include="StructUnion" Version="0.6.0" PrivateAssets="all" />
    <PackageReference Include="SumSharp" Version="2.6.0" />
    <ProjectReference Include="..\..\sources\Lite.Union\Lite.Union.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
